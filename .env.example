DJANGO_SECRET_KEY=replace-with-a-long-random-ascii-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=keshtazar.ir,www.keshtazar.ir
CSRF_TRUSTED_ORIGINS=https://keshtazar.ir,https://www.keshtazar.ir,https://sep.shaparak.ir
SECURE_SSL_REDIRECT=True
# Replace cpanel_account with the home directory shown in cPanel Domains.
PUBLIC_ROOT=/home/cpanel_account/public_html

MYSQL_DATABASE=cpanel_prefix_database
MYSQL_USER=cpanel_prefix_user
MYSQL_PASSWORD=replace-with-the-database-password
MYSQL_HOST=localhost
MYSQL_PORT=3306

API_KAVENEGAR=replace-with-the-api-key
ZARINPAL_MERCHANT_ID=replace-with-the-live-merchant-id
ZARINPAL_SANDBOX_MERCHANT_ID=replace-with-the-sandbox-merchant-id
SEP_TERMINAL=replace-with-the-sep-terminal-id
SEP_PASSWORD=replace-with-the-sep-password

# Website support widget and Rubika Bot API
SUPPORT_PHONE=09138825163
SUPPORT_RUBIKA_ENABLED=False
SUPPORT_RUBIKA_BOT_TOKEN=
SUPPORT_RUBIKA_CHAT_ID=
SUPPORT_RUBIKA_USER_ID=
SUPPORT_RUBIKA_WEBHOOK_SECRET=
SUPPORT_PUBLIC_URL=https://keshtazar.ir
# Optional: enable WebSocket push only on an ASGI host with a shared Redis service.
SUPPORT_WEBSOCKET_REDIS_URL=
